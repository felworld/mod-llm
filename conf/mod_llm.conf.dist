#
# mod-llm configuration
#
# Turns mod-playerbots bots into agentic LLM-driven characters. Each trigger
# (incoming chat, an emote, a game event, or an idle "initiative" tick) sends
# the bot's situation plus a tool list to an OpenAI-compatible chat-completions
# endpoint (vLLM by default). The model may call tools - send a message,
# perform an emote, write or delete a private memory note, invite to a
# party, challenge to a duel - or do nothing at all.
#

[worldserver]

########################################
# Core
########################################

#
#    LLM.Enable
#        Description: Master switch for the module.
#        Default:     0
#

LLM.Enable = 0

#
#    LLM.Endpoint
#        Description: Full URL of an OpenAI-compatible chat-completions endpoint.
#        Default:     "http://ac-vllm:8000/v1/chat/completions"
#

LLM.Endpoint = "http://ac-vllm:8000/v1/chat/completions"

#
#    LLM.ApiKey
#        Description: Bearer token sent as Authorization header. Empty = none.
#        Default:     ""
#

LLM.ApiKey = ""

#
#    LLM.Model
#        Description: Model name sent in requests. The ac-vllm service serves
#                     its model under the alias "felworld" regardless of which
#                     model is loaded, so this rarely needs to change.
#        Default:     "felworld"
#

LLM.Model = "felworld"

#
#    LLM.MaxTokens
#        Description: Response token cap per request.
#        Default:     200
#

LLM.MaxTokens = 200

#
#    LLM.Temperature / LLM.TopP / LLM.TopK
#        Description: Sampling overrides. Left unset, nothing is sent and
#                     the endpoint applies the model's own generation
#                     defaults - the values it was tuned for - with no conf
#                     edit needed when swapping models. (vLLM reads them
#                     from the model repo's generation_config.json; NB: not
#                     every repo ships one - the QuantTrio Qwen3.5 AWQ does,
#                     the official Qwen3.5 repo does not, and without one
#                     vLLM falls back to neutral defaults.) Set to override:
#                     negative unsets Temperature/TopP, 0 unsets TopK (a
#                     vLLM extension, never sent when unset).
#        Default:     (unset - use the model's defaults)
#

# LLM.Temperature = 0.7
# LLM.TopP = 0.8
# LLM.TopK = 20

#
#    LLM.RepetitionPenalty
#        Description: Penalty applied to tokens already present in the prompt
#                     or the response so far (> 1 discourages reuse). Counters
#                     bots parroting phrases out of their own conversation
#                     history. Kept mild so short netspeak habits (lol, gz)
#                     survive - verbal tics read as human. A vLLM extension:
#                     sent only when not 1.0, so set 1.0 to disable for strict
#                     OpenAI-spec endpoints.
#        Default:     1.05
#

LLM.RepetitionPenalty = 1.05

#
#    LLM.TimeoutSeconds
#        Description: HTTP connect/read/write timeout per request.
#        Default:     30
#

LLM.TimeoutSeconds = 30

#
#    LLM.MaxConcurrentRequests
#        Description: Number of HTTP worker threads (concurrent LLM requests).
#        Default:     8
#

LLM.MaxConcurrentRequests = 8

#
#    LLM.MaxQueueSize
#        Description: Pending-request cap. New requests are dropped (logged)
#                     when the queue is full, so a stalled LLM server can never
#                     back up into the game.
#        Default:     32
#

LLM.MaxQueueSize = 32

#
#    LLM.TreatBareContentAsSay
#        Description: If the model answers in plain prose instead of calling a
#                     tool, deliver that prose as a chat message.
#        Default:     1
#

LLM.TreatBareContentAsSay = 1

#
#    LLM.ErrorFeedback.Enable
#        Description: When a tool call fails at execution time, send the error
#                     back to the model so it can choose an alternative action.
#                     Follow-up rounds (including the ones read tools such as
#                     get_gear use to hand data back) are capped at two per
#                     trigger; read-tool data rounds run regardless of this
#                     setting.
#        Default:     1
#

LLM.ErrorFeedback.Enable = 1

#
#    LLM.Announce.Enable
#        Description: Broadcast a system-chat message to all players when the
#                     LLM endpoint becomes available or unavailable (the
#                     worldserver console is always notified).
#        Default:     1
#

LLM.Announce.Enable = 1

#
#    LLM.Debug.Enable / LLM.Debug.LogPrompts
#        Description: Verbose trigger/response/tool-outcome logging / full
#                     prompt logging.
#        Default:     0 / 0
#

LLM.Debug.Enable = 0
LLM.Debug.LogPrompts = 0

########################################
# Reactive chat
########################################

LLM.Chat.Enable = 1
LLM.Chat.EnableWhispers = 1

#
#    LLM.Chat.SayDistance / LLM.Chat.YellDistance
#        Description: How far away a bot can "hear" /say and /yell. 0 = hear
#                     exactly as far as players do (the server's
#                     ListenRange.Say / ListenRange.Yell).
#        Default:     0 / 0
#

LLM.Chat.SayDistance = 0
LLM.Chat.YellDistance = 0

#
#    LLM.Chat.Overhear.Enable
#        Description: Bots remember every say/yell within their hearing range
#                     - not just messages they were picked to answer - and
#                     recent overheard lines are included in their prompts.
#                     In-memory only (cleared on restart).
#        Default:     1
#

LLM.Chat.Overhear.Enable = 1

#
#    LLM.Chat.BotTrigger.Enable
#        Description: A bot's own audible speech (say/yell) and channel
#                     messages can trigger other bots to react - through the
#                     say/room routers when those are enabled, otherwise the
#                     LLM.Chat.BotReplyChance.* dice - so bots talk among
#                     themselves when humans are around to see it. Disable to
#                     make bots react to humans only.
#        Default:     1
#
#    LLM.Chat.BotTrigger.MaxChainDepth
#        Description: Cap on consecutive bot-to-bot hops from one origin
#                     (higher = longer bot conversations, more LLM calls).
#        Default:     3
#
#    LLM.Chat.BotTrigger.MaxBotsToPick
#        Description: Cap on bots reacting to one bot message (the router may
#                     still pick nobody). 1 keeps bot-to-bot exchanges linear
#                     conversations - only a real player's message can fan
#                     out to several responders (LLM.Chat.MaxBotsToPick).
#        Default:     1
#

LLM.Chat.BotTrigger.Enable = 1
LLM.Chat.BotTrigger.MaxChainDepth = 3
LLM.Chat.BotTrigger.MaxBotsToPick = 1

#
#    LLM.Chat.MaxBotsToPick
#        Description: Cap on bots reacting to one message. Party chat from a
#                     real player is exempt: every bot in the party is asked
#                     and the model decides who answers. For raid and
#                     battleground chat this caps the router's picks.
#        Default:     2
#

LLM.Chat.MaxBotsToPick = 2

#
#    LLM.Chat.StaggerSeconds
#        Description: Extra delay per additional bot when several react to the
#                     same message (the 2nd waits this long, the 3rd twice as
#                     long, ...). Each delayed bot rebuilds its context when
#                     its turn comes, so it sees the replies that landed before
#                     it instead of answering blind in parallel. 0 to disable.
#        Default:     5
#

LLM.Chat.StaggerSeconds = 5

#
#    LLM.Typing.CharsPerSecond
#        Description: Faux typing speed. A finished reply is delivered only
#                     once a human could have typed it: its length divided by
#                     this rate, counted from the moment of the message being
#                     answered - so the model's own latency eats into the
#                     typing time, and only replies that outran a human typist
#                     are held for the remainder. Long messages arrive later
#                     than quips, a bot's consecutive lines never overlap, and
#                     because history is recorded at delivery, bots that react
#                     later genuinely see what was said in the meantime.
#                     7 chars/s is roughly an 85 words-per-minute typist.
#                     0 disables the hold entirely.
#        Default:     7
#
#    LLM.Typing.MaxSeconds
#        Description: Longest a finished reply is ever held for typing realism.
#        Default:     15
#

LLM.Typing.CharsPerSecond = 7
LLM.Typing.MaxSeconds = 15

#
#    LLM.Chat.SkipInCombat
#        Description: Bots in combat never react.
#        Default:     1
#

LLM.Chat.SkipInCombat = 1

#
#    LLM.Chat.PlayerReplyChance.* / LLM.Chat.BotReplyChance.*
#        Description: Percent chance per candidate bot to react, split by
#                     whether the sender is a human player or another bot.
#                     With the say/group/room routers enabled (the default),
#                     most of these dice never roll: say/yell, guild,
#                     channel, and raid/battleground messages - from players
#                     and bots alike - are routed by an LLM call that judges
#                     who, if anyone, a message is for, and the matching
#                     chance here applies only with that router disabled.
#                     (An unparseable router reply routes to nobody and
#                     logs an error - no quiet degradation to dice.) For a
#                     real player's party chat, the default Party = 100
#                     means every bot in the party gets the message and the
#                     model itself decides whether to answer - the prompt
#                     tells bots to stay silent unless the message concerns
#                     them. BotReplyChance.Party/.Guild are reserved - bot
#                     group/guild chat is delivered without re-entering the
#                     trigger pipeline.
#                     .Defense overrides .Channel in the LocalDefense and
#                     WorldDefense channels, and rolls only with the room
#                     router disabled. Note that per-candidate dice scale
#                     with the audience: on a faction-wide channel even a
#                     low chance picks someone on nearly every message,
#                     which is why routing is the default there.
#

LLM.Chat.PlayerReplyChance.Say = 90
LLM.Chat.PlayerReplyChance.Party = 100
LLM.Chat.PlayerReplyChance.Guild = 70
LLM.Chat.PlayerReplyChance.Channel = 60
LLM.Chat.PlayerReplyChance.Defense = 15
LLM.Chat.BotReplyChance.Say = 10
LLM.Chat.BotReplyChance.Party = 25
LLM.Chat.BotReplyChance.Guild = 5
LLM.Chat.BotReplyChance.Channel = 3
LLM.Chat.BotReplyChance.Defense = 5

#
#    LLM.Chat.GroupRouter.Enable
#        Description: Route a real player's raid/battleground messages
#                     through one extra LLM call that reads the message plus
#                     a roster of the group's bots (class, spec, role) and
#                     picks which of them - if any - the message is meant
#                     for, up to MaxBotsToPick ("any mages got water?"
#                     reaches the mage, not two random bots). Bots addressed
#                     by name are always picked. When disabled, raid/BG chat
#                     falls back to random picks.
#        Default:     1
#

LLM.Chat.GroupRouter.Enable = 1

#
#    LLM.Chat.SayRouter.Enable
#        Description: Route say/yell - a real player's or a bot's - through
#                     one extra LLM call that reads the message, a roster of
#                     the bots in earshot, and the conversation recently
#                     overheard nearby, then picks which bots - if any - the
#                     message is meant for. An undirected "sure, how much?"
#                     right after a bot's offer reaches that bot, and idle
#                     muttering reaches nobody. The router also sees how
#                     crowded the spot is: the bigger the roster, the less
#                     likely any one bot was being addressed. Bots addressed
#                     by name are always picked. When disabled, say/yell
#                     falls back to the ReplyChance.Say dice.
#        Default:     1
#

LLM.Chat.SayRouter.Enable = 1

#
#    LLM.Chat.RoomRouter.Enable
#        Description: Route guild and named-channel messages (a real
#                     player's or a bot's) the same way: one extra LLM call
#                     reads the message, a roster sampled from the room's
#                     bots, and the room transcript, then picks who - if
#                     anyone - would naturally answer. Most channel chatter
#                     is read in silence, so the router usually answers
#                     "nobody" unless a bot is named, asked something it
#                     would know, or already mid-conversation.
#                     LocalDefense/WorldDefense route too, with an
#                     alarm-channel note in the routing prompt: nearly
#                     every alarm is answered by nobody, and a picked bot
#                     gets the go-or-stay-silent defense reply guidance
#                     (a short "omw" beside the go_defend tool when
#                     actually going, silence otherwise). The contract is
#                     enforced in code: a defense-channel reply only lands
#                     beside a successful go_defend, so declines never
#                     reach the channel even when the model types one.
#                     When disabled, guild/channel chat falls back to the
#                     ReplyChance.Guild/.Channel dice (.Defense in defense
#                     channels).
#        Default:     1
#

LLM.Chat.RoomRouter.Enable = 1

#
#    LLM.Chat.Router.MaxRoster
#        Description: Cap on candidate bots shown to a router in one routing
#                     call (a busy city channel could list dozens).
#                     Candidates beyond the cap are dropped at random for
#                     that message; a bot addressed by name always survives
#                     the cut.
#        Default:     12
#

LLM.Chat.Router.MaxRoster = 12

#
#    LLM.Chat.EnableCustomChannels
#        Description: React in player-created channels too.
#        Default:     1
#

LLM.Chat.EnableCustomChannels = 1

#
#    LLM.Chat.CrossFactionChatChance
#        Description: Percent chance that a bot reacting to an enemy-faction
#                     player's emote or deed is allowed to attempt chat anyway
#                     (which the enemy sees as untranslated gibberish - the
#                     classic cross-faction /say taunt). The rest of the time
#                     enemy game events draw no comment and enemy emotes get
#                     emotes back.
#        Default:     5
#

LLM.Chat.CrossFactionChatChance = 5

########################################
# Emote reactions
########################################

LLM.Emote.Enable = 1

#
#    LLM.Emote.TargetedChance / LLM.Emote.NearbyChance
#        Description: Percent chance to react to an emote aimed at the bot /
#                     performed nearby without a target.
#        Default:     100 / 10
#
#    LLM.Emote.Distance
#        Description: How far away a bot notices emotes. 0 = exactly as far
#                     as players see them (the server's ListenRange.TextEmote).
#        Default:     0
#

LLM.Emote.TargetedChance = 100
LLM.Emote.NearbyChance = 10
LLM.Emote.Distance = 0

########################################
# Game events
########################################

LLM.Event.Enable = 1

#
#    LLM.Event.BotDistance
#        Description: How close a bot must be to the event to comment.
#                     Comments about a groupmate's deed go to party/raid chat;
#                     others go to the zone channel (ChannelChance) or /say,
#                     and a /say comment only happens with a human in earshot.
#        Default:     40
#

LLM.Event.BotDistance = 40

LLM.Event.CooldownSeconds = 10
LLM.Event.MaxBotsPerEvent = 2

#
#    LLM.Event.Chance.*
#        Description: Percent chance per candidate bot, by event type.
#                     0 disables an event type entirely.
#                     GroupJoin fires when a bot joins a party or raid with a
#                     real player in it; the greeting goes to party/raid chat.
#                     Healed fires only for the healed bot itself when a
#                     player outside its group heals it; the thanks is said
#                     aloud. Groupmate heals are routine and never draw one.
#                     DefenseCallout/DefenseEscalation fire when playerbots'
#                     wpvp callout system picks a bot to raise the alarm
#                     (LocalDefense sighting / WorldDefense griefing-spree
#                     shout): the chosen bot speaks in its own words instead
#                     of the prebaked line (disabled in llm mode via
#                     AiPlayerbot.WpvpCallouts = 0). Already throttled hard
#                     on the playerbots side, hence the 100s. A LocalDefense
#                     callout is skipped when no human is in the zone to read
#                     it - travel responses ride the defense board either way.
#

LLM.Event.Chance.Kill = 15
LLM.Event.Chance.PvPKill = 40
LLM.Event.Chance.Death = 30
LLM.Event.Chance.QuestComplete = 20
LLM.Event.Chance.LevelUp = 50
LLM.Event.Chance.Duel = 40
LLM.Event.Chance.Achievement = 40
LLM.Event.Chance.Loot = 15
LLM.Event.Chance.GroupJoin = 100
LLM.Event.Chance.Healed = 20
LLM.Event.Chance.DefenseCallout = 100
LLM.Event.Chance.DefenseEscalation = 100

#
#    LLM.Event.ChannelChance
#        Description: Percent of event comments that go to the bot's zone
#                     General channel instead of /say (when the bot is on the
#                     channel and a real player is too; otherwise /say).
#        Default:     10
#

LLM.Event.ChannelChance = 10

#
#    LLM.Event.LootMinQuality
#        Description: Minimum item quality to trigger loot comments
#                     (0 poor, 1 common, 2 uncommon, 3 rare, 4 epic, 5 legendary).
#        Default:     3
#

LLM.Event.LootMinQuality = 3

########################################
# Initiative (unprompted behaviour)
########################################

LLM.Initiative.Enable = 1

#
#    LLM.Initiative.MinIntervalSeconds / MaxIntervalSeconds
#        Description: Per-bot random schedule between initiative opportunities.
#        Default:     45 / 180
#
#    LLM.Initiative.Chance
#        Description: Percent chance to actually act when an opportunity comes.
#        Default:     5
#

LLM.Initiative.MinIntervalSeconds = 45
LLM.Initiative.MaxIntervalSeconds = 180
LLM.Initiative.Chance = 5

#
#    LLM.Initiative.ChannelChance
#        Description: Percent of initiative remarks aimed at the bot's zone
#                     General channel instead of /say - the idle "anyone else
#                     lagging?" zone chatter real servers have. Requires the
#                     bot on the channel with a real player also on it;
#                     otherwise the remark stays /say, which requires a human
#                     in earshot.
#        Default:     25
#

LLM.Initiative.ChannelChance = 25
LLM.Initiative.MaxBotsPerTick = 2

########################################
# Memory scratchpad
########################################

#
#    LLM.Memory.*
#        Description: Each bot keeps a private scratchpad of short notes it
#                     writes itself via the remember/forget tools (people met,
#                     promises, grudges, plans), persisted to the characters
#                     DB. Prompts inject the bot's notes about the player it
#                     is interacting with plus its most recent general notes
#                     (MaxInjectedLines). When a bot hits MaxNotesPerBot (or
#                     MaxNotesPerSubject for one player) a new note is
#                     rejected with an error telling the model to forget or
#                     overwrite one first.
#

LLM.Memory.Enable = 1
LLM.Memory.MaxNotesPerBot = 40
LLM.Memory.MaxNotesPerSubject = 8
LLM.Memory.MaxContentLength = 300
LLM.Memory.MaxInjectedLines = 10
LLM.Memory.SaveIntervalSeconds = 60

########################################
# Conversation history
########################################

#
#    LLM.History.*
#        Description: Transcripts included in prompts: per bot<->player pair,
#                     per shared room (party/guild/channel) - both persisted
#                     to the characters DB - and per bot the overheard
#                     say/yell buffer (in-memory; see LLM.Chat.Overhear).
#                     MaxOverheardLines caps the overheard lines per prompt.
#                     Every line is timestamped. Room and overheard lines
#                     older than ScrollbackSeconds are left out of prompts -
#                     like chat that has scrolled off a player's chat window -
#                     so an event-woken bot only sees channel chatter that is
#                     still live. Pair transcripts are memory of a
#                     conversation with a person, so they stay, but lines
#                     more than a couple of minutes old carry an age tag
#                     ("(10 min ago)") so the bot picks the conversation up
#                     rather than continuing it mid-sentence.
#                     Retention is short: transcripts are working memory for
#                     coherence; anything worth keeping longer belongs in the
#                     bot's memory scratchpad (LLM.Memory.*).
#

LLM.History.Enable = 1
LLM.History.MaxPairTurns = 5
LLM.History.MaxRoomLines = 20
LLM.History.MaxOverheardLines = 10
LLM.History.ScrollbackSeconds = 300
LLM.History.SaveIntervalSeconds = 60
LLM.History.RetentionDays = 2

########################################
# Prompt templates
########################################

#
#    Prompt templates use {named} placeholders. Values are single-line; write
#    newlines inside a template as the two-character sequence \n. Available:
#      system:  {bot_name} {bot_level} {bot_class} {bot_race} {bot_faction}
#               {bot_area} {bot_zone} {bot_group} {bot_guild} {bot_quests}
#               {style_examples}
#               {bot_quests} is the bot's own quest log: titles plus a
#               ready-to-turn-in/failed marker, so quest talk stays honest
#      user:    {memory_block} {history_block} {channel_label} {actor_name}
#               {actor_level} {actor_class} {actor_race} {message} {environment}
#               {reply_guidance} (party/raid/bg chat: reminds the bot the
#               whole group heard the message and silence is a fine answer;
#               battleground chat additionally carries the live Warsong
#               Gulch score/flag status and the key to play callouts like
#               "inc", beside the bg_strategy tool;
#               zone-channel remarks: reminds it the whole zone hears it;
#               cross-faction emotes/events: explains the language barrier)
#               {memory_block} is the bot's own notes: those about the actor
#               plus its most recent general notes (see LLM.Memory.*)
#               {history_block} includes, when present: overheard nearby
#               say/yell, the shared room transcript, and the pair
#               conversation with the actor
#      router:  {channel_label} {actor_name} {message} {roster} {bg_note}
#               {max_picks}
#               ({bg_note} tells the router that battleground play callouts
#               concern the whole team; empty in raid chat)
#      say router: {actor_name} {message} {roster} {history_block} {max_picks}
#               ({history_block} is the say/yell recently overheard around
#               the sender, ending with the message being routed)
#      room router: {room_label} {actor_name} {message} {roster}
#               {history_block} {room_note} {max_picks}
#               ({room_label} names the room - guild chat or a channel;
#               {history_block} is the room transcript, ending with the
#               message being routed; {room_note} adds alarm-channel
#               guidance in defense channels, else empty)
#    LLM.Prompt.System and LLM.Prompt.StyleExamples are written out below
#    (identical to the built-in defaults) so they can be tuned without
#    rebuilding. Style guidance uses positive exemplars only - phrasing a rule
#    as "never say X" plants X in the context, and small local models then
#    produce it more, not less. Leave the other templates unset to use the
#    built-in defaults (recommended starting point).
#

LLM.Prompt.System = "You are {bot_name}, a level {bot_level} (of 80 max) {bot_race} {bot_class} of the {bot_faction} in World of Warcraft: Wrath of the Lich King, currently in {bot_area} ({bot_zone}). {bot_group}{bot_guild}{bot_quests}You are a real person playing your character at your keyboard - never an assistant. React to the situation using the available tools, or do nothing at all - most moments deserve no reaction. Never announce what you are doing and never mention tools or AI. You type like a WoW player in a hurry: mostly lowercase, light punctuation, netspeak and abbreviations where natural, usually just a few words and never more than 20, with no emojis, markdown, or quotation marks. Talk about the game the way players do - quests, mobs, drops, gold, specs, lag. You have your own goals and your own session going: you owe nobody help, and being busy, saying no, disagreeing, or ignoring people is all normal. Help when you feel like it, not to please. Skip apologies and compliments unless truly earned, and end a message with a question or an offer only when you actually want something. Reusing short casual words is fine, but vary your own wording rather than repeating whole phrases from the conversation history. Use the remember and forget tools to keep short private notes about people you meet and plans you make; whatever is relevant is shown back to you. You may call several tools in one reply.{style_examples}"

LLM.Prompt.StyleExamples = "\n\nHow you type - examples of situation => message you might send:\nstranger begs for gold => lol no\ngroupmate dings => gz\nasked where a vendor is and you know => by the fountain, cant miss it\nasked for a summon while you are busy => busy atm sry\nstranger wants to duel and you do not care => nah\nyou lose a duel => gf\nsomeone bows to you after a duel => well fought\nyou finally finish a rough quest => that quest was awful lol\ninvited to group mid-quest => maybe after this quest\nguildie asks who is up for deadmines => id come, need the vc sword\nsomeone says thanks => np\nsomeone says gg => gg\nyou die to something dumb => wow im bad\nsomeone keeps pestering you => dude stop\nyou agree to meet someone => omw\ndefense channel reports a ganker and you decide to go fight => hold on, omw\nyou spot an enemy player attacking a town => redridge under attack, lvl 60 rogue at the bridge"

# LLM.Prompt.Chat = ""
# LLM.Prompt.Emote = ""
# LLM.Prompt.Event = ""
# LLM.Prompt.Initiative = ""
# LLM.Prompt.HistoryLine = ""
# LLM.Prompt.Router = ""
# LLM.Prompt.SayRouter = ""
# LLM.Prompt.RoomRouter = ""
